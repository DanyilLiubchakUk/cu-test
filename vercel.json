{
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/prompt.js", "destination": "/shared/prompt.js" },
    { "source": "/favicon.svg", "destination": "/web/favicon.svg" },
    { "source": "/site.webmanifest", "destination": "/web/site.webmanifest" },
    { "source": "/robots.txt", "destination": "/web/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/web/sitemap.xml" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
